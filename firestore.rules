rules_version = '2';

// MedFollow Firestore rules (Tasks 2.6A and 3.2).
//
// COURSEWORK PROTOTYPE - fictional data only. Users self-select the Doctor
// role at registration; that is NOT professional verification, and these
// rules are not production-ready for real medical data.
//
// Doctor access to a patient comes only from an active
// doctorLinks/{patientId}_{doctorId} document created by the patient.
// UserProfile.linkedDoctorIds is never used for authorization.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function profile(id) {
      return get(/databases/$(database)/documents/users/$(id)).data;
    }

    function hasActiveLink(patientId, doctorId) {
      let path = /databases/$(database)/documents/doctorLinks/$(patientId + '_' + doctorId);
      return exists(path) && get(path).data.status == 'active';
    }

    // A code is usable if it exists, belongs to the doctor, is active, and
    // is less than 30 days old (server creation time).
    function codeUsable(code, doctorId) {
      let path = /databases/$(database)/documents/doctorCodes/$(code);
      let c = get(path).data;
      return exists(path)
        && c.doctorId == doctorId
        && c.active == true
        && request.time < c.createdAt + duration.value(30, 'd');
    }

    // True when the code's server creation time is after [time].
    function codeIssuedAfter(code, time) {
      return get(/databases/$(database)/documents/doctorCodes/$(code)).data.createdAt > time;
    }

    match /users/{uid} {
      function isOwner() {
        return signedIn() && me() == uid;
      }

      // Matches UserProfile.toMap(): displayName, email, role,
      // linkedDoctorIds. Limits mirror the app's form validation.
      function isValidProfile(data) {
        return data.keys().hasOnly(['displayName', 'email', 'role', 'linkedDoctorIds'])
          && data.keys().hasAll(['displayName', 'email', 'role', 'linkedDoctorIds'])
          && data.displayName is string
          && data.displayName.trim().size() > 0
          && data.displayName.size() <= 100
          && data.email is string
          && data.email.size() > 0
          && data.email.size() <= 254
          && data.role in ['patient', 'doctor']
          && data.linkedDoctorIds is list;
      }

      // Owner, or a doctor with an active link to this patient. Linked
      // doctors read single profiles by ID (no list access).
      allow get: if isOwner() || (signedIn() && hasActiveLink(uid, me()));
      allow list: if isOwner();

      // Own profile only, and no pre-linked doctors at registration.
      allow create: if isOwner()
        && isValidProfile(request.resource.data)
        && request.resource.data.linkedDoctorIds.size() == 0;

      // Owner may only change their display name; doctors can never write.
      allow update: if isOwner()
        && isValidProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName']);

      allow delete: if false;
    }

    // doctorCodes/{code}: { doctorId, doctorName, active, createdAt }
    match /doctorCodes/{code} {
      // Any signed-in user may look up one code by ID; codes cannot be
      // enumerated. Doctors may list only their own codes.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.doctorId == me();

      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{10}$')
        && profile(me()).role == 'doctor'
        && request.resource.data.keys().hasOnly(['doctorId', 'doctorName', 'active', 'createdAt'])
        && request.resource.data.keys().hasAll(['doctorId', 'doctorName', 'active', 'createdAt'])
        && request.resource.data.doctorId == me()
        && request.resource.data.doctorName == profile(me()).displayName
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      // Owner may only deactivate (one-way).
      allow update: if signedIn()
        && resource.data.doctorId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;

      allow delete: if signedIn() && resource.data.doctorId == me();
    }

    // doctorLinks/{patientId}_{doctorId}:
    // { patientId, doctorId, patientName, doctorName, linkCode, status,
    //   consentedAt, [revokedAt, revokedBy] }
    match /doctorLinks/{linkId} {
      // Fresh patient consent with a usable code. Used for both creation
      // and reactivation, so only the patient can (re)activate a link.
      function isConsentedActiveLink(d) {
        return d.keys().hasOnly(['patientId', 'doctorId', 'patientName', 'doctorName', 'linkCode', 'status', 'consentedAt'])
          && d.keys().hasAll(['patientId', 'doctorId', 'patientName', 'doctorName', 'linkCode', 'status', 'consentedAt'])
          && d.patientId == me()
          && d.doctorId is string
          && d.doctorId != me()
          && linkId == d.patientId + '_' + d.doctorId
          && profile(me()).role == 'patient'
          && profile(d.doctorId).role == 'doctor'
          && d.patientName == profile(me()).displayName
          && d.doctorName == profile(d.doctorId).displayName
          && d.status == 'active'
          && d.consentedAt == request.time
          && d.linkCode is string
          && codeUsable(d.linkCode, d.doctorId);
      }

      function isParty(d) {
        return signedIn() && (d.patientId == me() || d.doctorId == me());
      }

      // Parties only. Queries must filter on patientId == me or
      // doctorId == me.
      allow read: if isParty(resource.data);

      allow create: if signedIn() && isConsentedActiveLink(request.resource.data);

      allow update: if signedIn() && (
        // Revocation by either party: active -> revoked, identities fixed.
        (resource.data.status == 'active'
          && isParty(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'revokedAt', 'revokedBy'])
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedAt == request.time
          && request.resource.data.revokedBy == me())
        ||
        // Reactivation by the patient only: revoked -> active with a
        // usable code and fresh consent (revocation fields removed).
        // If the DOCTOR revoked, the code must have been issued after that
        // revocation, so the doctor's decision cannot be undone with an
        // older code.
        (resource.data.status == 'revoked'
          && resource.data.patientId == me()
          && isConsentedActiveLink(request.resource.data)
          && (resource.data.revokedBy == resource.data.patientId
              || codeIssuedAfter(request.resource.data.linkCode, resource.data.revokedAt)))
      );

      allow delete: if false;
    }

    // Person 2: one canonical medication/supply document. Soft deletion
    // keeps medication metadata available to historical dose records.
    function isPatientOwner(patientId) {
      return signedIn() && me() == patientId && profile(me()).role == 'patient';
    }

    function canReadMedication(patientId) {
      return isPatientOwner(patientId)
        || (signedIn() && profile(me()).role == 'doctor'
            && hasActiveLink(patientId, me()));
    }

    function validDailyTime(time) {
      return time is string && time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validMedicationTimes(times) {
      // Rules have no loops. Validate each of the 24 allowed positions.
      return times is list && times.size() > 0 && times.size() <= 24
          && times.toSet().size() == times.size()
          && (times.size() <= 0 || validDailyTime(times[0]))
          && (times.size() <= 1 || validDailyTime(times[1]))
          && (times.size() <= 2 || validDailyTime(times[2]))
          && (times.size() <= 3 || validDailyTime(times[3]))
          && (times.size() <= 4 || validDailyTime(times[4]))
          && (times.size() <= 5 || validDailyTime(times[5]))
          && (times.size() <= 6 || validDailyTime(times[6]))
          && (times.size() <= 7 || validDailyTime(times[7]))
          && (times.size() <= 8 || validDailyTime(times[8]))
          && (times.size() <= 9 || validDailyTime(times[9]))
          && (times.size() <= 10 || validDailyTime(times[10]))
          && (times.size() <= 11 || validDailyTime(times[11]))
          && (times.size() <= 12 || validDailyTime(times[12]))
          && (times.size() <= 13 || validDailyTime(times[13]))
          && (times.size() <= 14 || validDailyTime(times[14]))
          && (times.size() <= 15 || validDailyTime(times[15]))
          && (times.size() <= 16 || validDailyTime(times[16]))
          && (times.size() <= 17 || validDailyTime(times[17]))
          && (times.size() <= 18 || validDailyTime(times[18]))
          && (times.size() <= 19 || validDailyTime(times[19]))
          && (times.size() <= 20 || validDailyTime(times[20]))
          && (times.size() <= 21 || validDailyTime(times[21]))
          && (times.size() <= 22 || validDailyTime(times[22]))
          && (times.size() <= 23 || validDailyTime(times[23]));
    }

    function validMedication(d) {
      return d.keys().hasOnly(['patientId', 'name', 'doseAmount', 'doseUnit',
          'scheduledTimes', 'stockAmount', 'refillThreshold', 'isActive',
          'stockUnit', 'unitsPerDose', 'revision'])
        && d.keys().hasAll(['patientId', 'name', 'doseAmount', 'doseUnit',
          'scheduledTimes', 'stockAmount', 'refillThreshold', 'isActive',
          'stockUnit', 'unitsPerDose', 'revision'])
        && d.patientId is string
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.name == d.name.trim()
        && d.doseAmount is number && d.doseAmount > 0 && d.doseAmount <= 1000000000
        && d.doseUnit in ['tablet', 'capsule', 'mg', 'ml', 'IU']
        && validMedicationTimes(d.scheduledTimes)
        && d.stockAmount is int && d.stockAmount >= 0 && d.stockAmount <= 1000000000
        && d.refillThreshold is int && d.refillThreshold >= 0 && d.refillThreshold <= 1000000000
        && d.isActive is bool
        && d.stockUnit in ['tablet', 'capsule', 'ml', 'IU', 'package', 'unit']
        && (d.unitsPerDose == null || (d.unitsPerDose is int
            && d.unitsPerDose > 0 && d.unitsPerDose <= 1000000000))
        && d.revision is int && d.revision > 0;
    }

    match /medications/{medicationId} {
      // A creation transaction first reads its absent random document.
      allow get: if (signedIn() && !exists(/databases/$(database)/documents/medications/$(medicationId))
          && profile(me()).role == 'patient')
        || canReadMedication(resource.data.patientId);
      // Queries must include patientId equality. Rules are not filters.
      allow list: if canReadMedication(resource.data.patientId);
      allow create: if isPatientOwner(request.resource.data.patientId)
        && validMedication(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.isActive == true;
      allow update: if isPatientOwner(resource.data.patientId)
        && request.resource.data.patientId == resource.data.patientId
        && resource.data.isActive == true
        && validMedication(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;

      // A receipt and deduction commit together. Receipts never change.
      match /consumptions/{doseId} {
        function medicationBefore() {
          return get(/databases/$(database)/documents/medications/$(medicationId)).data;
        }
        function validReceipt(d) {
          let before = medicationBefore();
          let after = getAfter(/databases/$(database)/documents/medications/$(medicationId)).data;
          return d.keys().hasOnly(['patientId', 'doseRecordId', 'units', 'revision', 'createdAt'])
            && d.keys().hasAll(['patientId', 'doseRecordId', 'units', 'revision', 'createdAt'])
            && d.patientId == before.patientId
            && d.doseRecordId == doseId
            && d.doseRecordId.matches('^[A-Za-z0-9_-][A-Za-z0-9_.:-]{0,299}$')
            && d.units is int && d.units > 0 && d.units == before.unitsPerDose
            && d.revision == before.revision + 1 && d.revision == after.revision
            && before.isActive == true && after.isActive == true
            && after.stockAmount == before.stockAmount - d.units
            && after.stockAmount >= 0
            && after.diff(before).affectedKeys().hasOnly(['stockAmount', 'revision'])
            && d.createdAt == request.time;
        }
        allow get: if isPatientOwner(medicationBefore().patientId);
        allow list: if false;
        allow create: if isPatientOwner(medicationBefore().patientId)
          && validReceipt(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Person 1: doseRecords/{medicationId}_{yyyyMMdd}_{HHmm}
    // { patientId, medicationId, medicationName, scheduledTime, status,
    //   confirmedAt, doseAmount, doseUnit }
    // Only changed doses are saved ("scheduled" is never stored).
    // taken and missed are final; overdue may become taken or missed.
    match /doseRecords/{doseId} {
      function validDose(d) {
        return d.keys().hasOnly(['patientId', 'medicationId', 'medicationName',
            'scheduledTime', 'status', 'confirmedAt', 'doseAmount', 'doseUnit'])
          && d.keys().hasAll(['patientId', 'medicationId', 'medicationName',
            'scheduledTime', 'status', 'confirmedAt', 'doseAmount', 'doseUnit'])
          && d.patientId is string
          && d.medicationId is string
          // The ID must belong to this medication (one record per dose).
          && doseId.matches('^[A-Za-z0-9]+_[0-9]{8}_[0-9]{4}$')
          && doseId.split('_')[0] == d.medicationId
          && d.medicationName is string
          && d.medicationName.size() > 0 && d.medicationName.size() <= 100
          && d.scheduledTime is timestamp
          && d.status in ['taken', 'overdue', 'missed']
          && (d.doseAmount == null || (d.doseAmount is number && d.doseAmount > 0))
          && (d.doseUnit == null || d.doseUnit is string)
          // taken: real tap time (device clock within 10 minutes of the
          // server). overdue/missed: no tap time, and only once the
          // scheduled time has passed.
          && ((d.status == 'taken'
                && d.confirmedAt is timestamp
                && d.confirmedAt > request.time - duration.value(10, 'm')
                && d.confirmedAt < request.time + duration.value(10, 'm'))
              || (d.status != 'taken'
                && d.confirmedAt == null
                && d.scheduledTime < request.time));
      }

      // Same access as medications: the patient, or a doctor with an active
      // link (read-only). A transaction first reads a dose that may not
      // exist yet, so patients may "get" an absent document.
      allow get: if (resource == null && signedIn() && profile(me()).role == 'patient')
        || (resource != null && canReadMedication(resource.data.patientId));
      // Queries must include patientId equality. Rules are not filters.
      allow list: if canReadMedication(resource.data.patientId);

      allow create: if isPatientOwner(request.resource.data.patientId)
        && validDose(request.resource.data)
        && get(/databases/$(database)/documents/medications/$(request.resource.data.medicationId)).data.patientId == me();

      allow update: if isPatientOwner(resource.data.patientId)
        && resource.data.status == 'overdue'
        && request.resource.data.status in ['taken', 'missed']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'confirmedAt'])
        && validDose(request.resource.data);

      allow delete: if false;
    }

    // Everything else stays closed until
    // each feature defines its own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
